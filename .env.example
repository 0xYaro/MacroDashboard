# MacroDashboard environment. No values here, ever.
# See docs/CONTRACT.md, "Environment".

# ---- worker ----------------------------------------------------------------
# The Supabase session pooler, used with asyncpg. NOT the Data API: macro_raw and
# macro_core are deliberately unexposed, and a macro_mart flush must be one
# transaction, which PostgREST cannot span.
DATABASE_URL=

# Carried for the weekly authoring agent, which does go through the Data API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute path to the Obsidian vault root. The worker reads three files the
# OpenClaw crons write and never writes into the vault.
VAULT_PATH=

# No FRED key is required. The keyless fredgraph.csv endpoint serves every series,
# and FRED allowlists the User-Agent product token rather than requiring auth.

# Which source feeds each of the three OpenClaw feeds: vault (the worker parses the
# Obsidian note, the default) or desk (macro-agent desk writes the tables and the
# worker stops reading that note). Flipped one feed at a time at cutover.
# MACRO_FEED_SOURCE_CATALYSTS=vault
# MACRO_FEED_SOURCE_TAIL_RISKS=vault
# MACRO_FEED_SOURCE_HOLDINGS=vault

# ---- desk ------------------------------------------------------------------
# The least-privilege macro_desk login that `macro-agent desk` uses, on the session
# pooler (user macro_desk.<project-ref>). Written by `python3 supabase/desk_role.py`,
# never by hand. Without it the desk falls back to DATABASE_URL and says so.
MACRO_DESK_DATABASE_URL=

# ---- web -------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). The variable keeps this name so the
# Vercel project and the contract agree. The service-role key never appears here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development only. Never set on a deployment; a build without it has no fixture
# code path reachable at all.
# NEXT_PUBLIC_FIXTURES=1
