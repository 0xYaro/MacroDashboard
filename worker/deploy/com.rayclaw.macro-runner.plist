<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd user agent for the MacroDashboard run queue.

  Every Claude run this system makes goes through macro_core.run_request: the
  daily narrative, Monday's author, and the Refresh button on the Desk. This
  agent ticks the queue every two minutes; one tick applies an accept or reject
  the operator recorded, or claims and runs one queued request. See
  agent/src/macro_agent/runner.py.

  StartInterval, not KeepAlive. launchd never starts a second instance of a job
  while the first is still running, so a fifty-minute Monday author holds the
  queue and a Refresh pressed meanwhile waits its turn instead of racing it.

  install.sh rewrites the placeholders below. Do not edit this file to point at
  your own paths: run install.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rayclaw.macro-runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>__UV_BIN__</string>
    <string>run</string>
    <string>--frozen</string>
    <string>--project</string>
    <string>agent</string>
    <string>macro-agent</string>
    <string>runner</string>
    <string>tick</string>
  </array>

  <!-- The repository root, so the headless Claude session starts where SKILL.md expects. -->
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>

  <key>StartInterval</key>
  <integer>120</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- claude lives in ~/.local/bin, uv wherever install.sh found it. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>LOG_LEVEL</key>
    <string>INFO</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/runner.out.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/runner.err.log</string>
</dict>
</plist>
